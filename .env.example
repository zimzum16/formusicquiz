# --- Frontend ---
VITE_API_URL=http://localhost:3001
# язык интерфейса: ru | en
VITE_LANG=ru

# --- Backend (server/.env) ---
PORT=3001
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string
# DB_PATH=                  — путь к SQLite (по умолчанию db.sqlite; в Docker /data/db.sqlite)

# --- Внешние API ---
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# GENIUS_ACCESS_TOKEN=
# LASTFM_API_KEY=
# SETLISTFM_API_KEY=
# YOUTUBE_API_KEY=
# YANDEX_MUSIC_TOKEN=
# WIKI_USER_AGENT=          — UA для Wikidata/Wikipedia/MusicBrainz, обязательно с контактом:
#                             "SoundLens/1.0 (https://your-site.ru; you@example.com)"
#                             без контакта Wikimedia режет до 10 запросов/мин

# --- Скрейпинг страниц Genius (обход 403), все опциональны, ключи через запятую ---
# SCRAPERBEE_KEYS=
# SCRAPERAPI_KEYS=          — или один ключ в SCRAPERAPI_KEY
# SCRAPERDO_KEYS=           — или один ключ в SCRAPERDO_KEY
# SCRAPE_PROXY_URL=         — URL бэкенда на VPS с /api/scrape (для Vercel, чей IP блокирует Genius)

# --- Кэш ---
# UPSTASH_REDIS_REST_URL=   — персистентный кэш (Upstash Redis, для Vercel)
# UPSTASH_REDIS_REST_TOKEN= — без этих двух переменных кэш работает в памяти

# --- Уведомления о фидбеке ---
# NTFY_TOPIC=               — топик ntfy.sh
