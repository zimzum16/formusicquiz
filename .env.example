# --- Frontend ---
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend (server/.env) ---
PORT=3001
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string

# --- Внешние API (добавить в Этапе 3) ---
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# GENIUS_ACCESS_TOKEN=
# SCRAPERAPI_KEY=         — опционально, для обхода 403 на страницах Genius
# UPSTASH_REDIS_REST_URL=   — персистентный кэш (Upstash Redis, для Vercel)
# UPSTASH_REDIS_REST_TOKEN= — без этих двух переменных кэш работает в памяти
# WIKI_USER_AGENT=          — UA для Wikidata/Wikipedia/MusicBrainz, обязательно с контактом:
#                             "SoundLens/1.0 (https://your-site.ru; you@example.com)"
#                             без контакта Wikimedia режет до 10 запросов/мин

# --- Telegram-уведомления о фидбеке ---
# TELEGRAM_BOT_TOKEN=       — токен от @BotFather
# TELEGRAM_CHAT_ID=         — твой chat_id (написать боту → api.telegram.org/bot{TOKEN}/getUpdates)
